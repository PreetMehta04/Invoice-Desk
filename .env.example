# Copy to .env and fill in ONE key. With no key the app still runs, using the local OCR + parser engine.
# Engine selection: auto (first key found) | anthropic | gemini | openai | local
EXTRACTION_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Watch data/inbox for dropped PDFs (simulated AP mailbox)
WATCH_INBOX=1
